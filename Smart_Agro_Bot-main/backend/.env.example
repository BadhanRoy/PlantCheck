
# --- Required ---
GOOGLE_API_KEY= khuje nao

# --- Model ---
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Feature flags ---
SMARTAGRO_IMAGE_HINT=1
SMARTAGRO_CORRECT_STT=1
SMARTAGRO_DEBUG_RAG=0
# --- Rate limiting ---
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- Sizes ---
MAX_IMAGE_BYTES=5242880
MAX_AUDIO_BYTES=8388608
MAX_AUDIO_DURATION_MS=90000

# Text limits
MAX_TEXT_CHARS=2000
MAX_TTS_CHARS=2500
MAX_HISTORY_JSON_BYTES=20000

# --- CORS ---
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# --- Voice ---
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_SKIP_PREPROCESS=false
EDGE_TTS_VOICE=bn-BD-NabanitaNeural